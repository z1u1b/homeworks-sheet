# Токен Telegram-бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID таблицы Google Sheets (из URL: https://docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit)
GOOGLE_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Путь к JSON-файлу сервисного аккаунта Google
GOOGLE_CREDENTIALS_FILE=credentials.json

# Название листа (вкладки) в таблице с домашними заданиями
GOOGLE_SHEET_NAME=Homework

# Файл базы данных SQLite (создастся автоматически)
DB_PATH=homeworks.db

# Часовой пояс и время уведомлений по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_NOTIFY_TIME=20:00

# За сколько часов до дедлайна (тег [ЧЧ:ММ] в тексте задания) напоминать по
# умолчанию — сама функция у каждого пользователя выключена, пока он не
# включит её в /settings; это только число часов.
DEFAULT_DEADLINE_HOURS=3

# Время (по часовому поясу пользователя), в которое бот раз в день тихо
# проверяет, не выросла ли Google-таблица за пределы последнего оформления
# (предмет/дата дописаны руками) и докатывает формат, если да. Работает
# только для таблиц с доступом на запись (созданных через /create_sheet).
REFORMAT_CHECK_TIME=03:30

# Сколько секунд кэшировать данные из таблицы, чтобы не превышать лимиты Google API
SHEET_CACHE_TTL=120

# --- Автосоздание таблицы через /create_sheet (OAuth пользователя) ---
# Получить в Google Cloud Console: APIs & Services -> Credentials ->
# OAuth client ID -> Web application. Redirect URI должен быть
# ровно <OAUTH_PUBLIC_BASE_URL>/oauth/callback.
# Если не заполнены — /create_sheet отвечает, что функция не настроена,
# остальной бот работает как обычно.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Публичный домен с HTTPS, на который смотрит nginx перед ботом (Google
# OAuth не принимает голый IP в redirect_uri). Без /oauth/callback на конце.
OAUTH_PUBLIC_BASE_URL=https://your-domain.example
# Порт, на котором бот сам поднимает aiohttp для /oauth/callback (127.0.0.1),
# наружу его пробрасывает nginx на порт 443.
OAUTH_CALLBACK_PORT=8081

# --- Allowlist онбординга ---
# chat_id'ы через запятую, кому разрешено пользоваться ботом. Узнать свой
# chat_id: команда /whoami (доступна всем, даже не из списка). Пусто —
# allowlist выключен, бот открыт для всех.
ALLOWED_CHAT_IDS=

